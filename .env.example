# Python inference service (src/backend/app.py)
INFERENCE_API_URL=http://127.0.0.1:8001

# Firebase Realtime Database REST base URL (see docs/database-schema.md)
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.<region>.firebasedatabase.app

# Server-only credentials. The rules deny every client read/write, so only this server can access the DB.
# Option A: Database Secret (Firebase console > Project settings > Service accounts > Database secrets)
FIREBASE_DATABASE_SECRET=
# Option B: service account key file kept outside the repository
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/outside/repo/firebase-service-account.json

# Next.js 서버 → Python 추론 서버(src/backend/app.py) 공유 비밀값. 두 서버가 같은 값을 써야 한다.
# 브라우저에 노출되지 않도록 NEXT_PUBLIC_ 접두어를 붙이지 않는다. 생성: openssl rand -hex 32
# 비어 있으면 추론 서버는 모든 요청에 503("backend token not configured")을 반환한다(fail-closed).
# 로컬 개발에서만 인증을 끄려면 추론 서버 실행 시 INSIGHT_ALLOW_UNAUTHENTICATED=1 을 명시한다.
INSIGHT_BACKEND_TOKEN=
