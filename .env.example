# Python inference service (src/backend/app.py)
INFERENCE_API_URL=http://127.0.0.1:8001

# Firebase Realtime Database REST base URL (use your own project; see README "Realtime Database")
FIREBASE_DATABASE_URL=https://<your-project>-default-rtdb.firebaseio.com

# Service account key (Firebase console > Project settings > Service accounts > Generate new private key).
# Keep it outside the repository; the rules deny every client read/write, so only this server can access the DB.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/outside/repo/firebase-service-account.json
